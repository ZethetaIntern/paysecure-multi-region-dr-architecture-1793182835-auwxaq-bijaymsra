#########################################
# Project
#########################################

project_name = "paysecure-dr"

environment = "production"

#########################################
# AWS Regions
#########################################

primary_region = "ap-south-1"

dr_region = "ap-south-2"

#########################################
# Availability Zones
#########################################

primary_azs = [
  "ap-south-1a",
  "ap-south-1b",
  "ap-south-1c"
]

dr_azs = [
  "ap-south-2a",
  "ap-south-2b",
  "ap-south-2c"
]

#########################################
# Primary VPC
#########################################

primary_vpc_cidr = "10.0.0.0/16"

primary_public_subnets = [
  "10.0.1.0/24",
  "10.0.2.0/24",
  "10.0.3.0/24"
]

primary_private_app_subnets = [
  "10.0.11.0/24",
  "10.0.12.0/24",
  "10.0.13.0/24"
]

primary_private_db_subnets = [
  "10.0.21.0/24",
  "10.0.22.0/24",
  "10.0.23.0/24"
]

#########################################
# Disaster Recovery VPC
#########################################

dr_vpc_cidr = "10.1.0.0/16"

dr_public_subnets = [
  "10.1.1.0/24",
  "10.1.2.0/24",
  "10.1.3.0/24"
]

dr_private_app_subnets = [
  "10.1.11.0/24",
  "10.1.12.0/24",
  "10.1.13.0/24"
]

dr_private_db_subnets = [
  "10.1.21.0/24",
  "10.1.22.0/24",
  "10.1.23.0/24"
]

#########################################
# Amazon EKS
#########################################

kubernetes_version = "1.33"

node_instance_type = "m7g.large"

desired_nodes = 3

min_nodes = 3

max_nodes = 10

#########################################
# Aurora PostgreSQL
#########################################

aurora_engine_version = "16.6"

aurora_instance_class = "db.r7g.large"

#########################################
# ElastiCache Redis
#########################################

redis_node_type = "cache.r7g.large"

#########################################
# Amazon MSK
#########################################

kafka_version = "3.8.x"

kafka_instance_type = "kafka.m7g.large"

#########################################
# Common Tags
#########################################

common_tags = {

  Project = "PaySecure"

  Environment = "Production"

  Owner = "Cloud Engineering"

  ManagedBy = "Terraform"

  Repository = "paysecure-multi-region-dr-architecture"

  CostCenter = "Payments"

  BusinessUnit = "Digital Banking"

  Application = "Payment Gateway"

}
